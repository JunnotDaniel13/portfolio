# Public canonical origin used for SEO. Use the production URL at build/runtime.
VITE_SITE_URL=https://junnot-daniel.vercel.app
SITE_URL=https://junnot-daniel.vercel.app

# Required in production. Use a long random value (for example: openssl rand -hex 32).
COOKIE_SECRET=

# Header populated by your trusted reverse proxy, for example: x-real-ip.
# Never set this to x-forwarded-for unless your proxy sanitizes that header.
# Only set this when a reverse proxy YOU control sets the header and strips client-supplied values.
# Docker Compose publishes the port directly (no proxy), so it defaults to a shared limit instead.
CLIENT_IP_HEADER=
# Escape hatch for a single-instance deployment without a proxy (shared-IP limiting):
# ALLOW_SHARED_RATE_LIMIT=1
ALLOWED_ORIGINS=

EMAIL_ADDRESS=
GMAIL_PASSKEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
